SEANIME_SERVER_HOST=0.0.0.0
SEANIME_SERVER_PORT=8787
SEANIME_DATA_DIR=/data
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=
# Map Jellyfin's in-container paths to paths mounted inside anime-manager.
# Example: Jellyfin /SMB/JP-BEAN/... -> manager /ivan/...
JELLYFIN_PATH_MAP=/SMB/JP-BEAN=/ivan
QBITTORRENT_URL=http://qbittorrent:8080
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
MANAGER_API_TOKEN=
